<!-- Interface do instalador. Carregada em tempo de execução por Setup.cs (XamlReader):
     os textos vêm de Setup.cs pelo Tag="t:chave", os eventos são ligados pelo x:Name.
     Layout pensado para o papel de parede: a arte fica livre à esquerda (título embaixo) e
     o cartão de vidro escuro fica à direita, sobre um degradê que acalma a imagem. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pulseman" Width="1040" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#F7F3FA"/>
    <SolidColorBrush x:Key="Soft" Color="#C9BCD6"/>
    <SolidColorBrush x:Key="Dim" Color="#8F7FA3"/>
    <SolidColorBrush x:Key="Accent" Color="#FF4FA6"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#66FF4FA6"/>
    <SolidColorBrush x:Key="AccentTint" Color="#24FF4FA6"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF7DC4" Offset="0"/>
      <GradientStop Color="#E3176F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerFill" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF8A6A" Offset="0"/>
      <GradientStop Color="#D9303F" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,11"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="MinWidth" Value="118"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="11" Background="{StaticResource PrimaryFill}" Opacity="0.0" Margin="-3">
                <Border.Effect><BlurEffect Radius="16"/></Border.Effect>
              </Border>
              <Border x:Name="bg" CornerRadius="10" Background="{StaticResource PrimaryFill}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border CornerRadius="10,10,0,0" Height="14" VerticalAlignment="Top" Background="#1FFFFFFF" IsHitTestVisible="False"/>
              <Border x:Name="shine" CornerRadius="10" Opacity="0" Background="#26FFFFFF"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="shine" Property="Opacity" Value="1"/>
                <Setter TargetName="glow" Property="Opacity" Value="0.6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bg" CornerRadius="10" Background="{StaticResource DangerFill}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="shine" CornerRadius="10" Opacity="0" Background="#30FFFFFF"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shine" Property="Opacity" Value="1"/></Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#24FFFFFF"/>
                <Setter TargetName="bg" Property="BorderBrush" Value="#55FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E6FFFFFF"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- botões de idioma: o escolhido recebe Tag="on" pelo código -->
    <Style x:Key="LangButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#B3FFFFFF"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="7" Padding="9,5" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="Tag" Value="on">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource PrimaryFill}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox como chave liga/desliga -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Background="#1FFFFFFF"
                      BorderBrush="#40FFFFFF" BorderThickness="1">
                <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#CFC4DA" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource PrimaryFill}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- link de texto (ex.: "Por que preciso da ROM?") -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"/>
                <TextBlock Text="i" FontSize="10" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
              </Grid>
              <TextBlock x:Name="label" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="label" Property="TextDecorations" Value="Underline"/>
                <Setter Property="Foreground" Value="#FF8CCB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Soft}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
  </Window.Resources>

  <!-- margem para a sombra da janela -->
  <Grid Margin="18">
    <Border CornerRadius="18" Background="#070310">
      <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.6" Color="Black"/></Border.Effect>
    </Border>

    <Grid x:Name="Shell">
      <!-- fundo de reserva (sem papel de parede): degradê e ondas animadas -->
      <Grid x:Name="FallbackBg">
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#3A0A2E" Offset="0"/>
              <GradientStop Color="#1A0B2E" Offset="0.55"/>
              <GradientStop Color="#070310" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Canvas x:Name="Waves" ClipToBounds="True"/>
      </Grid>

      <!-- papel de parede, alinhado à esquerda para a arte do Pulseman não ser cortada -->
      <Image x:Name="Wallpaper" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Center"
             Visibility="Collapsed" RenderTransformOrigin="0.3,0.45" RenderOptions.BitmapScalingMode="HighQuality">
        <Image.RenderTransform><ScaleTransform x:Name="WallpaperZoom"/></Image.RenderTransform>
      </Image>

      <!-- a imagem é muito clara: um véu leve em tudo e degradês só onde há texto -->
      <Rectangle Fill="#1F070310"/>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00070310" Offset="0.38"/>
            <GradientStop Color="#A6070310" Offset="0.56"/>
            <GradientStop Color="#EB070310" Offset="0.78"/>
            <GradientStop Color="#F2070310" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#99070310" Offset="0"/>
            <GradientStop Color="#00070310" Offset="0.13"/>
            <GradientStop Color="#00070310" Offset="0.6"/>
            <GradientStop Color="#E6070310" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="452"/></Grid.ColumnDefinitions>

        <!-- barra de título -->
        <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
            <Image x:Name="AppIcon" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="PULSEMAN" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Tag="t:installer" Foreground="#B3FFFFFF" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="InfoButton" Style="{StaticResource ChromeButton}" Width="38" Margin="0,0,6,0">
              <Grid Width="17" Height="17">
                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"/>
                <TextBlock Text="i" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Grid>
            </Button>
            <Button x:Name="LangPt" Style="{StaticResource LangButton}" Content="PT"/>
            <Button x:Name="LangEn" Style="{StaticResource LangButton}" Content="EN"/>
            <Button x:Name="LangEs" Style="{StaticResource LangButton}" Content="ES"/>
            <Rectangle Width="1" Height="16" Fill="#40FFFFFF" Margin="10,0"/>
            <Button x:Name="MinButton" Style="{StaticResource ChromeButton}">
              <Rectangle Width="11" Height="1.2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CloseButton}">
              <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- título embaixo, à esquerda, sobre o degradê -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="44,0,0,34">
          <TextBlock Text="PULSEMAN" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="60" FontWeight="Black">
            <TextBlock.Foreground>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0.25"/>
                <GradientStop Color="#FFC4E4" Offset="1"/>
              </LinearGradientBrush>
            </TextBlock.Foreground>
            <TextBlock.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#2A0018" Opacity="0.85"/></TextBlock.Effect>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="4,-4,0,0">
            <Rectangle Width="26" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource PrimaryFill}" VerticalAlignment="Center" Margin="0,2,10,0"/>
            <TextBlock Tag="t:subtitle" FontSize="17" Foreground="White" FontWeight="SemiBold">
              <TextBlock.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="Black" Opacity="0.7"/></TextBlock.Effect>
            </TextBlock>
          </StackPanel>
          <TextBlock x:Name="VersionText" Foreground="#B3FFFFFF" FontSize="11.5" Margin="4,10,0,0"/>
        </StackPanel>

        <!-- cartão de vidro com as páginas -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,6,32,32" CornerRadius="18" Padding="32,24,32,28"
                Background="#D90D0818" BorderBrush="#2BFFFFFF" BorderThickness="1">
          <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>

            <!-- etapas -->
            <StackPanel x:Name="Steps" Orientation="Horizontal" Margin="0,0,0,22">
              <Border x:Name="Step1Dot" Width="22" Height="22" CornerRadius="11"><TextBlock x:Name="Step1Num" Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="Step1Text" Tag="t:step_rom" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
              <Rectangle Width="20" Height="1" Fill="#33FFFFFF" Margin="10,0" VerticalAlignment="Center"/>
              <Border x:Name="Step2Dot" Width="22" Height="22" CornerRadius="11"><TextBlock x:Name="Step2Num" Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="Step2Text" Tag="t:step_install" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
              <Rectangle Width="20" Height="1" Fill="#33FFFFFF" Margin="10,0" VerticalAlignment="Center"/>
              <Border x:Name="Step3Dot" Width="22" Height="22" CornerRadius="11"><TextBlock x:Name="Step3Num" Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
              <TextBlock x:Name="Step3Text" Tag="t:step_done" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <!-- boas-vindas -->
              <Grid x:Name="PageWelcome">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Tag="t:welcome_title" Style="{StaticResource Heading}"/>
                  <TextBlock Tag="t:welcome_body" Style="{StaticResource Body}"/>
                  <StackPanel Margin="0,22,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentTint}">
                        <Path Data="M2,4 L18,4 L18,14 L2,14 Z M6,17 L14,17" Stroke="{StaticResource Accent}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Tag="t:feat1" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock Tag="t:feat1b" Foreground="{StaticResource Dim}" FontSize="12.5"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                      <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentTint}">
                        <Path Data="M11,1 L4,11 L9,11 L7,19 L15,8 L10,8 Z" Fill="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Tag="t:feat2" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock Tag="t:feat2b" Foreground="{StaticResource Dim}" FontSize="12.5"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource AccentTint}">
                        <Path Data="M3,2 L15,2 L18,5 L18,18 L3,18 Z M6,2 L6,7 L14,7 L14,2 M6,12 L15,12" Stroke="{StaticResource Accent}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Tag="t:feat3" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock Tag="t:feat3b" Foreground="{StaticResource Dim}" FontSize="12.5"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Tag="t:start"/>
                </StackPanel>
              </Grid>

              <!-- ROM -->
              <Grid x:Name="PageRom" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Tag="t:rom_title" Style="{StaticResource Heading}"/>
                  <TextBlock Tag="t:rom_body" Style="{StaticResource Body}"/>
                  <Button x:Name="InfoLink" Style="{StaticResource LinkButton}" Tag="t:info_link" Margin="0,8,0,0"/>
                  <Grid x:Name="DropZone" Height="124" Margin="0,14,0,0" AllowDrop="True" Cursor="Hand" Background="#08FFFFFF">
                    <Rectangle x:Name="DropBorder" RadiusX="14" RadiusY="14" Stroke="{StaticResource AccentSoft}" StrokeThickness="1.6" StrokeDashArray="5,4"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentTint}" HorizontalAlignment="Center">
                        <Path Data="M12,18 L12,4 M6,9 L12,3 L18,9 M4,21 L20,21" Stroke="{StaticResource Accent}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Tag="t:drop" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,10,0,2"/>
                      <TextBlock Tag="t:browse" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" FontSize="12.5"/>
                    </StackPanel>
                  </Grid>
                  <Border x:Name="RomStatus" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="12" Padding="14,11" Background="#14FFFFFF">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <Border x:Name="RomStatusDot" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center">
                        <Path x:Name="RomStatusIcon" Stroke="White" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RomStatusTitle" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="RomStatusDetail" Foreground="{StaticResource Dim}" FontSize="12.5" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="RomBack" Style="{StaticResource SecondaryButton}" Tag="t:back"/>
                  <Button x:Name="RomNext" Style="{StaticResource PrimaryButton}" Tag="t:next" IsEnabled="False"/>
                </StackPanel>
              </Grid>

              <!-- pasta e opções -->
              <Grid x:Name="PageOptions" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Tag="t:opt_title" Style="{StaticResource Heading}"/>
                  <TextBlock Tag="t:opt_body" Style="{StaticResource Body}"/>
                  <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border CornerRadius="10" Background="#12FFFFFF" BorderBrush="#2BFFFFFF" BorderThickness="1" Padding="14,10">
                      <TextBlock x:Name="FolderText" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Border>
                    <Button x:Name="FolderButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Tag="t:change" MinWidth="96"/>
                  </Grid>
                  <TextBlock x:Name="SpaceText" Foreground="{StaticResource Dim}" FontSize="12.5" Margin="2,8,0,14"/>
                  <CheckBox x:Name="OptDesktop" Style="{StaticResource Switch}" Tag="t:opt_desktop" IsChecked="True"/>
                  <CheckBox x:Name="OptStart" Style="{StaticResource Switch}" Tag="t:opt_start" IsChecked="True"/>
                  <CheckBox x:Name="OptLaunch" Style="{StaticResource Switch}" Tag="t:opt_launch" IsChecked="True"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="OptBack" Style="{StaticResource SecondaryButton}" Tag="t:back"/>
                  <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Tag="t:install"/>
                </StackPanel>
              </Grid>

              <!-- progresso -->
              <Grid x:Name="PageProgress" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}"/>
                  <TextBlock x:Name="ProgressStatus" Style="{StaticResource Body}" Margin="0,0,0,24"/>
                  <Grid>
                    <Border x:Name="ProgressTrack" Height="10" CornerRadius="5" Background="#1FFFFFFF"/>
                    <Border x:Name="ProgressFill" Height="10" CornerRadius="5" HorizontalAlignment="Left" Width="0" Background="{StaticResource PrimaryFill}">
                      <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FF4FA6" Opacity="0.85"/></Border.Effect>
                    </Border>
                  </Grid>
                  <TextBlock x:Name="ProgressPercent" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" Margin="0,10,0,0" FontSize="12.5"/>
                </StackPanel>
              </Grid>

              <!-- concluído (instalação ou remoção) -->
              <Grid x:Name="PageDone" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Grid Width="92" Height="92" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="DoneScale"/></Grid.RenderTransform>
                    <Ellipse Fill="{StaticResource PrimaryFill}">
                      <Ellipse.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="0" Color="#FF4FA6" Opacity="0.75"/></Ellipse.Effect>
                    </Ellipse>
                    <Path Data="M28,48 L41,61 L65,35" Stroke="White" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                  </Grid>
                  <TextBlock x:Name="DoneTitle" Style="{StaticResource Heading}" HorizontalAlignment="Center" Margin="0,24,0,8"/>
                  <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" TextAlignment="Center" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="DoneClose" Style="{StaticResource SecondaryButton}" Tag="t:close"/>
                  <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Tag="t:play"/>
                </StackPanel>
              </Grid>

              <!-- desinstalar -->
              <Grid x:Name="PageUninstall" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Tag="t:un_title" Style="{StaticResource Heading}"/>
                  <TextBlock Tag="t:un_body" Style="{StaticResource Body}"/>
                  <Border CornerRadius="10" Background="#12FFFFFF" BorderBrush="#2BFFFFFF" BorderThickness="1" Padding="14,10" Margin="0,18,0,16">
                    <TextBlock x:Name="UnFolderText" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"/>
                  </Border>
                  <CheckBox x:Name="OptKeepSaves" Style="{StaticResource Switch}" Tag="t:un_keep" IsChecked="True"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="UnCancel" Style="{StaticResource SecondaryButton}" Tag="t:cancel"/>
                  <Button x:Name="UnConfirm" Style="{StaticResource DangerButton}" Tag="t:uninstall"/>
                </StackPanel>
              </Grid>

              <!-- erro -->
              <Grid x:Name="PageError" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource DangerFill}" HorizontalAlignment="Left">
                    <Path Data="M0,0 L18,18 M18,0 L0,18" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Tag="t:err_title" Style="{StaticResource Heading}" Margin="0,20,0,8"/>
                  <TextBlock x:Name="ErrorText" Style="{StaticResource Body}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="ErrBack" Style="{StaticResource SecondaryButton}" Tag="t:back"/>
                  <Button x:Name="ErrClose" Style="{StaticResource PrimaryButton}" Tag="t:close"/>
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- informações sobre a ROM (botão ⓘ e link da página da ROM), por cima de tudo -->
      <Grid x:Name="InfoOverlay" Visibility="Collapsed" Background="#B3050209">
        <Border x:Name="InfoCard" Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18"
                Padding="34,30" Background="#F20D0818" BorderBrush="#33FFFFFF" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform x:Name="InfoScale"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/></Border.Effect>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource PrimaryFill}">
                <TextBlock Text="i" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,0,0,2"/>
              </Border>
              <TextBlock Tag="t:info_title" Style="{StaticResource Heading}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Tag="t:info_body1" Style="{StaticResource Body}" Foreground="{StaticResource Text}"/>
            <TextBlock Tag="t:info_body2" Style="{StaticResource Body}" Margin="0,12,0,0"/>
            <Border CornerRadius="10" Background="{StaticResource AccentTint}" BorderBrush="{StaticResource AccentSoft}" BorderThickness="1"
                    Padding="14,11" Margin="0,16,0,0">
              <TextBlock Tag="t:info_body3" Style="{StaticResource Body}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
            </Border>
            <Button x:Name="InfoOk" Style="{StaticResource PrimaryButton}" Tag="t:info_ok" HorizontalAlignment="Right" Margin="0,24,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
